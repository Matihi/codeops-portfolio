@baseUrl = http://localhost:{{$dotenv PORT}}/api/v1

### Register a new customer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "almaz@example.et",
    "password": "Password123!"
}

### Try the same email again - expect 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "almaz@example.et",
    "password": "Password123!"
}

### Invalid email - expect 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "not-an-email",
    "password": "Password123!"
}

### Short password - expect 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "new@example.et",
    "password": "123"   
}

### Extra role field - expect 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "new2@example.et",
    "password": "Password123!",
    "roles": ["admin"]

}

### Login with the registered user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "almaz@example.et",
    "password": "Password123!"
}

### Wrong password - expect same 401 message
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "almaz@example.et",
    "password": "WrongPassword123!"
}

### Unknown email - expect same 401 message
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "nobody@example.et",
    "password": "Password123!"
}

###

@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoiYWxtYXpAZXhhbXBsZS5ldCIsInJvbGVzIjpbImN1c3RvbWVyIl0sImlhdCI6MTc5NTYxNTA1NywiZXhwIjoxNzk1NjE1OTU3fQ.ycneLTuPXJnNv_KRz-eKxRz1JtIYiqJoOLX9_WVMvc8

### No token - expect 401
GET {{baseUrl}}/auth/me

### Valid token - expect 200 and the user object
GET {{baseUrl}}/auth/me 
Authorization: Bearer {{accessToken}}

### Tampered token - expect 401
GET {{baseUrl}}/auth/me 
Authorization: Bearer {{accessToken}}x

### Refresh using the refresh token returned by login
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImlhdCI6MTc5NTYxNTA5MSwiZXhwIjoxNzk2MjE5ODkxfQ.z1RTRU-2S5egvu7AIkeSJsAmmtTkVfaQ8xTzgUMyXY8"
}